        "# STEP 17: Polypharmacy classification\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# Start with one row per participant\n",
        "final_rx = rx_person.copy()\n",
        "\n",
        "# Assign zero to participants who reported no medication use\n",
